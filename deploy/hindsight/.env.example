# Copy to .env, configure your provider, and restrict permissions to 600.
PG_PASSWORD=replace-with-a-random-database-password
LLM_KEY=replace-with-your-provider-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-chat-model
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=bge-m3
# Set a random access key for the control panel on port 9999.
CP_ACCESS_KEY=replace-with-a-random-control-panel-key
